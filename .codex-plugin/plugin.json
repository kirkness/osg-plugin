{
  "name": "osg",
  "version": "0.4.1",
  "description": "Build, preview and publish browser games with Codex: original design, local multiplayer, leaderboards and hosting on Our Silly Games.",
  "author": {
    "name": "Our Silly Games",
    "url": "https://oursilly.games"
  },
  "homepage": "https://oursilly.games",
  "repository": "https://github.com/kirkness/osg-plugin",
  "license": "MIT",
  "keywords": [
    "games",
    "browser-games",
    "multiplayer",
    "leaderboards",
    "game-dev"
  ],
  "skills": "./codex/skills/",
  "mcpServers": "./.mcp.json",
  "hooks": [],
  "interface": {
    "displayName": "Our Silly Games",
    "shortDescription": "Turn your idea into a playable browser game",
    "defaultPrompt": [
      "Make me a game about..."
    ]
  },
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./codex/skills/osg-start/SKILL.md"
    }
  }
}
